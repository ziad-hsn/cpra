{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CPRa single-owner deployment values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "maintenance": {
      "type": "boolean"
    },
    "nameOverride": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 40
    },
    "fullnameOverride": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 48
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
            "maxLength": 253,
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "existingSecret",
        "key"
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "existingConfigMap": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "existingClaim": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*$",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        "revision": {
          "type": "string"
        }
      },
      "required": [
        "existingSecret",
        "existingConfigMap",
        "existingClaim",
        "key",
        "file",
        "revision"
      ],
      "oneOf": [
        {
          "properties": {
            "existingSecret": {
              "minLength": 1
            },
            "existingConfigMap": {
              "const": ""
            },
            "existingClaim": {
              "const": ""
            }
          }
        },
        {
          "properties": {
            "existingSecret": {
              "const": ""
            },
            "existingConfigMap": {
              "minLength": 1
            },
            "existingClaim": {
              "const": ""
            }
          }
        },
        {
          "properties": {
            "existingSecret": {
              "const": ""
            },
            "existingConfigMap": {
              "const": ""
            },
            "existingClaim": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "allowEmpty": {
      "type": "boolean"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "raft",
            "memory"
          ]
        }
      },
      "required": [
        "mode"
      ]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessMode": {
          "enum": [
            "ReadWriteOncePod",
            "ReadWriteOnce"
          ]
        },
        "acknowledgeReadWriteOnce": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "existingClaim",
        "size",
        "accessMode",
        "acknowledgeReadWriteOnce"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "port"
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "host": {
          "type": "string"
        },
        "path": {
          "const": "/"
        },
        "tlsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "className",
        "host",
        "path",
        "tlsSecret",
        "annotations"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "create",
        "name",
        "annotations"
      ]
    },
    "kubernetesRecovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "restartDeployments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
          "uniqueItems": true
        },
        "scaleDeployments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "enabled",
        "restartDeployments",
        "scaleDeployments"
      ]
    },
    "icmp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "go": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memoryLimit": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(MiB|GiB)$"
        }
      },
      "required": [
        "memoryLimit"
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 60
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 3
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 3
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 3
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        }
      },
      "required": [
        "startup",
        "readiness",
        "liveness"
      ]
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "not": {
          "pattern": "^(checksum/runtime|cpra\\.io/manifest-revision)$"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "enabled",
        "ingress",
        "egress"
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "providerFiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        }
      },
      "required": [
        "existingSecret"
      ]
    },
    "providerEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "enum": [
                "GOMEMLIMIT",
                "GOMAXPROCS"
              ]
            }
          },
          "secret": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
            "maxLength": 253
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        },
        "required": [
          "name",
          "secret",
          "key"
        ]
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    }
  },
  "required": [
    "maintenance",
    "nameOverride",
    "fullnameOverride",
    "image",
    "imagePullSecrets",
    "auth",
    "manifest",
    "allowEmpty",
    "storage",
    "persistence",
    "service",
    "ingress",
    "serviceAccount",
    "kubernetesRecovery",
    "icmp",
    "resources",
    "go",
    "terminationGracePeriodSeconds",
    "probes",
    "podAnnotations",
    "nodeSelector",
    "tolerations",
    "affinity",
    "networkPolicy",
    "test",
    "providerFiles",
    "providerEnv",
    "api"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "mode": {
                "const": "raft"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "persistence": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "persistence": {
            "properties": {
              "enabled": {
                "const": false
              },
              "existingClaim": {
                "const": ""
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "persistence": {
            "properties": {
              "accessMode": {
                "const": "ReadWriteOnce"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "persistence": {
            "properties": {
              "acknowledgeReadWriteOnce": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "host": {
                "minLength": 1
              },
              "tlsSecret": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "serviceAccount": {
            "properties": {
              "create": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "serviceAccount": {
            "properties": {
              "name": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "api": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "auth": {
            "properties": {
              "existingSecret": {
                "minLength": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
