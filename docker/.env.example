# Create the files and grant only the container UID/GID read access.
CPRA_IMAGE=ghcr.io/ziad-hsn/cpra:v0.1.0-rc.1
CPRA_MANIFEST_FILE=/absolute/path/monitors.yaml
CPRA_TOKEN_FILE=/absolute/path/cpra-api-v1
# Default token policy: UID 1001 owner, mode 0400 or 0600.
# For a root-owned token, group 1001, mode 0440 or 0640, explicitly enable:
# CPRA_TOKEN_READER_GROUP=1001
# Optional runtime settings file; otherwise use runtime.yaml beside this bundle.
# CPRA_RUNTIME_FILE=/absolute/path/runtime.yaml
CPRA_DATA_VOLUME=cpra-data
CPRA_MEMORY_LIMIT=1g
GOMEMLIMIT=512MiB
