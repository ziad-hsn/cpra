# Development source build; release image uses the exact tested native binaries.
FROM --platform=$BUILDPLATFORM node:24.21.0-alpine@sha256:be80f76cf40ec8e42b9bec49f60a55e0660f30af58d3e5a25530785b30ea67e2 AS dashboard
WORKDIR /src/dashboard
RUN npm install --global pnpm@11.22.0
COPY dashboard/package.json dashboard/pnpm-lock.yaml dashboard/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY dashboard/ ./
COPY brand/ /src/brand/
RUN pnpm build

FROM --platform=$BUILDPLATFORM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS builder
WORKDIR /src
ENV GOENV=off GOWORK=off GOTOOLCHAIN=local CGO_ENABLED=0 GOAMD64=v1 GOARM64=v8.0 GOFLAGS="" GOEXPERIMENT=""
RUN apk add --no-cache python3
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY internal/ ./internal/
COPY cmd/cpractl/ ./cmd/cpractl/
COPY *.go LICENSE ./
RUN rm -rf internal/web/server/assets
COPY --from=dashboard /src/dashboard/dist/ ./internal/web/server/assets/
COPY scripts/release/ ./scripts/release/
COPY --from=dashboard /src/dashboard/package.json ./dashboard/package.json
COPY --from=dashboard /src/dashboard/node_modules/ ./dashboard/node_modules/
COPY --from=dashboard /src/brand/fonts/LICENSE.txt ./brand/fonts/LICENSE.txt
COPY --from=dashboard /src/brand/fonts/RobotoSlab-Bold.ttf ./brand/fonts/RobotoSlab-Bold.ttf
ARG TARGETOS
ARG TARGETARCH
ARG BUILD_TAGS="redis,postgres,mysql,mongo,rabbitmq,kafka,kubernetes,aws,systemd,teams,twilio"
ARG VERSION="dev"
ARG COMMIT="unknown"
ARG BUILD_DATE="unknown"
RUN --mount=type=cache,target=/go/pkg/mod python3 scripts/release/package.py --version container --tags "$BUILD_TAGS" --notices-only --out /out/licenses
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -mod=readonly -pgo=off -buildvcs=false -tags "$BUILD_TAGS" -ldflags="-X github.com/ziad-hsn/cpra/internal/version.Version=$VERSION -X github.com/ziad-hsn/cpra/internal/version.Commit=$COMMIT -X github.com/ziad-hsn/cpra/internal/version.Date=$BUILD_DATE" -o /out/cpra . && \
    GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -mod=readonly -pgo=off -buildvcs=false -tags "$BUILD_TAGS" -ldflags="-X github.com/ziad-hsn/cpra/internal/version.Version=$VERSION -X github.com/ziad-hsn/cpra/internal/version.Commit=$COMMIT -X github.com/ziad-hsn/cpra/internal/version.Date=$BUILD_DATE" -o /out/cpractl ./cmd/cpractl

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN test -s /etc/ssl/certs/ca-certificates.crt && addgroup -g 1001 -S cpra && adduser -u 1001 -S cpra -G cpra
WORKDIR /var/lib/cpra
COPY --from=builder /out/cpra /out/cpractl /usr/local/bin/
COPY LICENSE /usr/share/licenses/cpra/LICENSE
COPY --from=builder /out/licenses/ /usr/share/licenses/cpra/
RUN mkdir -p /var/lib/cpra && chown 1001:1001 /var/lib/cpra && chmod 0700 /var/lib/cpra
COPY docker/runtime.yaml /etc/cpra/runtime.yaml
USER 1001:1001
EXPOSE 8060
STOPSIGNAL SIGTERM
ENTRYPOINT ["cpra"]
CMD ["-yaml", "/etc/cpra/monitors.yaml", "-runtime-config", "/etc/cpra/runtime.yaml"]
