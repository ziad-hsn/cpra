{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPRa local management principal policy",
  "description": "Verifier-only local bootstrap policy. CPRa additionally rejects duplicate principal IDs and token verifiers, reserved IDs, and invalid Unicode/control characters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["principals"],
  "properties": {
    "principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "token_sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "role": {"enum": ["reader", "operator"]},
          "token_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "revoked": {"type": "boolean"},
          "expires_at": {"type": "string", "format": "date-time", "description": "Optional absolute expiration; omission means non-expiring."}
        }
      }
    }
  }
}
