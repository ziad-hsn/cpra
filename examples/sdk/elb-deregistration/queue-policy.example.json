{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReceiveOnlyDesignatedEventBridgeRule",
      "Effect": "Allow",
      "Principal": {"Service": "events.amazonaws.com"},
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:123456789012:cpra-deregister",
      "Condition": {
        "ArnEquals": {"aws:SourceArn": "arn:aws:events:us-east-1:123456789012:rule/cpra-deregister"},
        "StringEquals": {"aws:SourceAccount": "123456789012"}
      }
    }
  ]
}
