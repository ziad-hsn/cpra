{
  "schema_version": 1,
  "go_version": "go1.27.1",
  "module": "github.com/ziad-hsn/cpra",
  "build_flags": [
    "-trimpath",
    "-mod=readonly",
    "-pgo=off",
    "-buildvcs=false",
    "-p=2"
  ],
  "build_tags": [
    "redis",
    "postgres",
    "mysql",
    "mongo",
    "rabbitmq",
    "kafka",
    "kubernetes",
    "aws",
    "systemd",
    "teams",
    "twilio"
  ],
  "targets": [
    "linux_amd64",
    "linux_arm64",
    "darwin_amd64",
    "darwin_arm64",
    "windows_amd64",
    "windows_arm64"
  ],
  "binaries": {
    "cpra": ".",
    "cpractl": "./cmd/cpractl"
  },
  "environment": {
    "GOENV": "off",
    "GOWORK": "off",
    "GOTOOLCHAIN": "local",
    "CGO_ENABLED": "0",
    "GOAMD64": "v1",
    "GOARM64": "v8.0",
    "GOEXPERIMENT": "",
    "GOFLAGS": "",
    "GOPROXY": "https://proxy.golang.org",
    "GOSUMDB": "sum.golang.org",
    "GOPRIVATE": "",
    "GONOPROXY": "",
    "GONOSUMDB": ""
  },
  "frontend": {
    "node_version": "v24.21.0",
    "pnpm_version": "11.22.0"
  },
  "storage_format_version": 14,
  "package_revision": "1",
  "embedded_inputs": [
    "internal/httpserver/assets",
    "internal/localadmin/templates"
  ],
  "package_version_encoding": "semver-order-v1"
}
